generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model marketplace_items {
  id                String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  source            String    @db.VarChar(50)
  quantity          Int
  price_per_unit    Decimal   @db.Decimal(10, 2)
  percentage_change Decimal   @default(0.00) @db.Decimal(5, 2)
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  updated_at        DateTime? @default(now()) @db.Timestamptz(6)

  @@index([source], map: "idx_marketplace_items_source")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model transactions {
  id               String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id          String    @db.Uuid
  type             String    @db.VarChar(20)
  source           String    @db.VarChar(50)
  quantity         Int
  price            Decimal   @default(0.00) @db.Decimal(10, 2)
  transaction_date DateTime  @default(now()) @db.Timestamptz(6)
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  updated_at       DateTime? @default(now()) @db.Timestamptz(6)
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([transaction_date], map: "idx_transactions_transaction_date")
  @@index([user_id], map: "idx_transactions_user_id")
}

model users {
  id                String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  wallet_address    String         @unique @db.VarChar(255)
  username          String?        @db.VarChar(50)
  email             String?        @unique @db.VarChar(255)
  total_irecs       Decimal        @default(0.00) @db.Decimal(10, 2)
  value_usd         Decimal        @default(0.00) @db.Decimal(10, 2)
  percentage_change Decimal        @default(0.00) @db.Decimal(5, 2)
  created_at        DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?      @default(now()) @db.Timestamptz(6)
  transactions      transactions[]

  @@index([wallet_address], map: "idx_users_wallet_address")
}
